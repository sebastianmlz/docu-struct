# ==========================================
# DocuStruct - Variables de Entorno
# ==========================================

# OpenAI API Key (Requerido para inferencia multimodal)
OPENAI_API_KEY=sk-proj-tu-api-key-aqui

# Modelo OpenAI a utilizar (por defecto el nuevo gpt-5.6-terra, o alternativamente gpt-4o)
OPENAI_MODEL=gpt-5.6-terra

# Nivel de pensamiento/razonamiento para la familia 5.6 (low, medium, high)
OPENAI_REASONING_EFFORT=medium

# Límites de Ingesta y Procesamiento
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES_PER_DOCUMENT=10

# Pipeline Visual (pypdfium2)
# 150 DPI proporciona un balance óptimo entre nitidez OCR/tablas y costo de tokens
PDF_RENDER_DPI=150

# Servidor ASGI / FastAPI
HOST=0.0.0.0
PORT=8000
DEBUG=True
